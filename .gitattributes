# Keep this Linux/Android build tree predictable on Windows checkouts.
* text=auto

.gitattributes   text eol=lf
.gitignore       text eol=lf
*.sh             text eol=lf
*.py             text eol=lf
*.rc             text eol=lf
*.mk             text eol=lf
*.bp             text eol=lf
*.md             text eol=lf
*.json           text eol=lf
*.xml            text eol=lf
*.h              text eol=lf
*.hpp            text eol=lf
*.cpp            text eol=lf
*.c              text eol=lf

# Binary assets and prebuilt blobs: never convert line endings.
*.png   binary
*.jpg   binary
*.ttf   binary
*.otf   binary
*.zip   binary
*.img   binary
*.bin   binary
*.so    binary
*.a     binary
